  <rdf:Description rdf:about="http://purl.org/spar/bido/author-citation-count">
    <rdf:type rdf:resource="http://purl.org/spar/bido/BibliometricMeasure"/>
    <rdf:type rdf:nodeID="n16989240426d470a9f8ba79d280bfa1db1"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/bido-standard-bibliometric-measures/"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:label>author citation count</rdfs:label>
    <rdfs:comment>The count of all the citation received by all the papers of a certain author.</rdfs:comment>
    <vann:example>
    :my-numeric-bibliometric-data a bido:NumericBibliometricData ;
        bido:hasMeasure bido:author-citation-count ;
        bido:hasNumericValue "56"^^xsd:integer .
    </vann:example>
  </rdf:Description>
